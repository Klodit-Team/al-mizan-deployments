# ── Docker Compose — Global Config ───────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=password

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# TODO: replace with strong random secrets before deploying
ACCESS_TOKEN_SECRET=dev-access-secret-change-in-production
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-in-production
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=localhost

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=al-mizan-docs

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── Client (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# ── Email / Resend (for notifications) ────────────────────────────────────────
FROM_EMAIL=noreply@klodit.app
RESEND_API_KEY=re_E3L3mDJy_E86Ww4Up199bHVGbcGBZyQU5# ═══════════════════════════════════════════════════════════════════════════════
# AL-MIZAN — AI Layer Environment Variables
# Copy to .env.ai and fill in values before running docker-compose.ai.yml.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Agent trigger parameters (set per-run or via orchestrator) ──────────────
AO_ID=
SUBMISSION_ID=
GAG_ID=
USER_ID=
JUSTIFICATION_TEXT=
REGULATORY_RULES_JSON=
SUPPORTING_DOCUMENT_IDS_JSON=
ANOMALY_ALERT_THRESHOLD=1
RELATED_AO_SET_JSON=
REQUIRED_FIELDS_JSON=
FIELDS_SCHEMA_JSON=
CONFIDENCE_THRESHOLD=0
ALERT_THRESHOLD_DAYS=
ALERT_USER_IDS=
SECTION_TYPE=
USER_PROMPT=
LLM_SENSITIVITY=non_sensitive
EVALUATION_ID=

# ─── Internal service tokens (optional but recommended for production) ────────
AO_SERVICE_TOKEN=
SOUMMISSION_SERVICE_TOKEN=
DOCUMENTS_SERVICE_TOKEN=
EVALUATION_SERVICE_TOKEN=
USERS_SERVICE_TOKEN=
NOTIFICATIONS_SERVICE_TOKEN=
AUDIT_SERVICE_TOKEN=

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Set at least one of these for production.
# On-premise (Ollama, vLLM, Mistral) or external (Gemini via OpenAI-compat API).
LLM_ONPREM_ENDPOINT=
LLM_EXTERNAL_ENDPOINT=
LLM_TIMEOUT_MS=20000

# ─── External AI/ML microservices ─────────────────────────────────────────────
# Change to docker service names if running these inside the compose network.
DOC_ANALYSIS_BASE_URL=http://localhost:4011
DOC_ANALYSIS_TIMEOUT_MS=20000
NLP_BASE_URL=http://localhost:4014
NLP_TIMEOUT_MS=15000
ANOMALY_BASE_URL=http://localhost:4012
ANOMALY_TIMEOUT_MS=20000

# ─── New AI endpoints (auto-wired in docker-compose.ai.yml) ─────────────────
# These are set to sensible defaults in docker-compose.ai.yml.
# Only override if your service URL scheme differs.
# AO_GRE_A_GRE_SCORE_ENDPOINT=/appels-offres/gre-a-gre/{demandeId}/score-ia
# SOUMMISSION_ANOMALY_ENDPOINT=/api/v1/soumissions/{soumissionId}/anomalies
# EVALUATION_SCORE_IA_ENDPOINT=/api/v1/evaluations/{evaluationId}/soumissions/{submissionId}/score-ia
# EVALUATION_COMPARISON_ENDPOINT=/api/v1/evaluations/{evaluationId}/soumissions/{submissionId}/comparison
