# ═══════════════════════════════════════════════════════════════════════════════
# AL-MIZAN — Environment Variables Template
# Copy to .env and fill in values before running docker compose.
# Used by docker-compose.yml (services) — NOT the AI layer (.env.ai for that).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=password
# Individual service DB names are baked into docker-compose.yml defaults.

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production-too
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=localhost

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=al-mizan-docs

# ─── Redis ───────────────────────────────────────────────────────────────────
# Managed inside Docker network; no external config needed unless overriding.

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ─── Client ──────────────────────────────────────────────────────────────────
# Must point to API Gateway public URL (or localhost:3000 for local dev).
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# ─── Production overrides (fill for prod deployment) ─────────────────────────
# COOKIE_DOMAIN=.klodit.app
# CORS_ORIGINS=https://klodit.app,https://api.klodit.app
# NEXT_PUBLIC_API_URL=https://api.klodit.app
